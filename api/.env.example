# Run the API on the host with Mailpit listening locally.
PORT=3001
PRODUCT_API_BASE_URL=https://fakestoreapi.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=catalogue@example.test
SALES_EMAIL=sales@example.test

# Set to true to review the app with bundled sample products.
USE_SAMPLE_CATALOGUE=false
